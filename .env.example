# Environment Configuration
# Copy this file to .env and fill in your values

# OpenWeather API (optional - enables weather tools)
# OPENWEATHER_API_KEY=your_openweather_api_key

# NASA API (optional - enables NASA tools with higher rate limits)
# NASA_API_KEY=your_nasa_api_key

# National Park Service API (required - get free key at https://www.nps.gov/subjects/developer/get-started.htm)
# NPS_API_KEY=your_nps_api_key

# API Timeout (seconds)
API_TIMEOUT=30

# Logging
LOG_LEVEL=info

# Development Settings
DEBUG=false
