# Environment Configuration
# Copy this file to .env and fill in your values

# OpenWeather API (optional - enables weather tools)
# OPENWEATHER_API_KEY=your_openweather_api_key

# NASA API (optional - enables NASA tools with higher rate limits)
# NASA_API_KEY=your_nasa_api_key

# FRED API (required for FRED economic data tools)
# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=your_fred_api_key

# BLS API (optional - increases query limit from 25 to 500 per day)
# BLS_API_KEY=your_bls_api_key

# API Timeout (seconds)
API_TIMEOUT=30

# Logging
LOG_LEVEL=info

# Development Settings
DEBUG=false
